# Prevent script execution and block non-image files in upload directory
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|cgi|pl|py|sh|bash|exe|bat|cmd|ps1|js|html|htm|txt|log|bak|sql)$">
    Require all denied
</FilesMatch>

# Disable script handlers and engines
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .phps .phar .cgi .pl .py

Options -Indexes -ExecCGI
